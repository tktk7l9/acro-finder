/**
 * acro-finder — Cloudflare Workers configuration
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * Builds Next.js with @opennextjs/cloudflare and runs it on Workers.
 * Migrated because the Vercel Hobby account has been suspended since 2026-08-11.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acro-finder",
  "main": ".open-next/worker.js",
  // This date is validated in UTC. Entering "today" in JST can fail with an
  // "in the future" error because it is still the previous day in UTC (actually hit in ai-primer).
  "compatibility_date": "2026-09-14",
  // Required to run Next.js. The date must be 2024-09-23 or later.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
