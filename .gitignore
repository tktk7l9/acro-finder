# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.log

# local env files
# keyway pull -e <env> writes files named .env.development / .env.production.
# Ignoring only .env*.local and .env lets those slip through and puts the Resend
# API key in a public repository. Ignore all .env.* and let only the examples through.
.env
.env.*
!.env*.example

# vercel
.vercel

# coverage
/coverage

# @opennextjs/cloudflare build output / wrangler local state
.open-next/
.wrangler/
# wrangler local secrets
.dev.vars
.dev.vars.*

# Generated into public/ by scripts/export-static.mjs (served as Workers static assets)
/public/_headers
/public/index.html
/public/events.html
/public/skills.html
/public/facilities.html
/public/facilities/
/public/area/
/public/icon.svg
/public/apple-icon
/public/favicon.ico
/public/opengraph-image
/public/twitter-image
/public/manifest.webmanifest
/public/sitemap.xml
/public/robots.txt
