# local env files
# keyway pull -e <env> writes files named .env.development / .env.production.
# Ignoring only .env*.local and .env lets those slip through and puts the Resend
# API key in a public repository. Ignore all .env.* and let only the examples through.
.env
.env.*
!.env*.example

# vercel
.vercel

# coverage
/coverage

# @opennextjs/cloudflare build output / wrangler local state
.open-next/
.wrangler/
